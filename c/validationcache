/*******************************************************************
 * File:        cache
 * Purpose:     Caching for the validation strings for icons
 * Author:      Gerph
 * Date:        16 Mar 2026
 ******************************************************************/

/* This is an experiment to see if caching the validation strings might
 * be a useful operation.
 *
 * Principles:
 *  Some keys are requested more than others (rendering ones)
 *  Some strings can be decoded once and not referred to again.
 *  Some strings will be long and should not be processed.
 *  Validation strings may need to be re-cached.
 */

#include <stdlib.h>
#include <string.h>

#include "validationcache.h"
#include "validation.h"

/*************************************************** Gerph *********
 Function:      validationcache_create
 Description:   Create a cache entry for a validation string
 Parameters:    vstr-> pointer to a validation string (ctrl-terminated)
 Returns:       pointer to a cache structure or NULL if failed to allocate
 ******************************************************************/
validationcache_t *validationcache_create(const char *vstr)
{
    validationcache_t *vc;
    vc = malloc(sizeof(*vc));
    if (vc == NULL)
        return NULL;

    /* We've got to parse the things that are in the cache now */
    memset(vc, 0, sizeof(*vc));
    {
        int start = 0;
        int len;
        int next;
        while ((next = validation_findcommand(vstr + start, Validation_EnumerateAll, &len)) != Validation_NotFound)
        {
            const char *p = &vstr[start + next];
            char cmd = *p++;

            next = start + next + len;
            if (cmd >= 'a' && cmd <= 'z')
                cmd = cmd - 32;
            if (cmd >= 'A' && cmd <= 'Z')
            {
                /* This is a character command, so we can mark it present in the boolean table */
                /* NOTE: We're assuming that the bitfield is numbered from lowest bit 0 */
                uint32_t *bitfield = (uint32_t*)&vc->valid;
                *bitfield |= (1<<(cmd-'A'));

                /* Now perform interpretation on the field */
                switch (cmd)
                {
                    case WimpValidation_Allow:            /* 'A': Allow following chars */
                        vc->allow_offset = p - vstr; /* FIXME: Should we store the length too ? */
                        break;

                    case WimpValidation_InterfaceModule:  /* 'B': Border type used by interface module */
                        break;

                    case WimpValidation_Colour:           /* 'C': Select icon colours (in 24-bit) */
                        {
                            int i;
                            for (i = 0; i < 6; i++)
                            {
                                if (len >= 7)
                                {
                                    uint32_t r, g, b;
                                    char hex[7];
                                    int j;
                                    for (j = 0; j < 6; j++)
                                        hex[j] = *p++;
                                    hex[6] = '\0';
                                    len -= 6;

                                    r = 0; g = 0; b = 0;
                                    for (j = 0; j < 2; j++) {
                                        char c = hex[j];
                                        b <<= 4;
                                        if (c >= '0' && c <= '9') b |= (c - '0');
                                        else if (c >= 'a' && c <= 'f') b |= (c - 'a' + 10);
                                        else if (c >= 'A' && c <= 'F') b |= (c - 'A' + 10);
                                    }
                                    for (j = 2; j < 4; j++) {
                                        char c = hex[j];
                                        g <<= 4;
                                        if (c >= '0' && c <= '9') g |= (c - '0');
                                        else if (c >= 'a' && c <= 'f') g |= (c - 'a' + 10);
                                        else if (c >= 'A' && c <= 'F') g |= (c - 'A' + 10);
                                    }
                                    for (j = 4; j < 6; j++) {
                                        char c = hex[j];
                                        r <<= 4;
                                        if (c >= '0' && c <= '9') r |= (c - '0');
                                        else if (c >= 'a' && c <= 'f') r |= (c - 'a' + 10);
                                        else if (c >= 'A' && c <= 'F') r |= (c - 'A' + 10);
                                    }

                                    vc->colours[i] = (b << 24) | (g << 16) | (r << 8);

                                    if (len > 0 && *p == '/') { p++; len--; }
                                }
                                else break;
                            }
                        }
                        break;

                    case WimpValidation_Display:          /* 'D': Display char following for password */
                        {
                            char c = len > 1 ? *p++ : 0;
                            if (c == '\\')
                                c = *p;
                            vc->display_char = c;
                        }
                        break;

                    case WimpValidation_Font:             /* 'F': Select font foreground/background hex colours */
                        vc->font_wimpbg = WimpColour_None;
                        vc->font_wimpfg = WimpColour_None;
                        if (len == 3)
                        {
                            /* Only populate if the length is exactly 2 chars */
                            char c = *p++;
                            if (c >= '0' && c <= '9')
                                vc->font_wimpbg = c - '0'; /* 0-9 */
                            else if ((c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F'))
                                vc->font_wimpbg = (c & 31) + 9; /* 10-15 */

                            c = *p++;
                            if (c >= '0' && c <= '9')
                                vc->font_wimpfg = c - '0'; /* 0-9 */
                            else if ((c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F'))
                                vc->font_wimpfg = (c & 31) + 9; /* 10-15 */
                        }
                        break;

                    case WimpValidation_Key:              /* 'K': Allow wimp key processing */
                        vc->key_offset = p - vstr; /* FIXME: Should we store the length too ? */
                        break;

                    case WimpValidation_Line:             /* 'L': Set line spacing in OS units */
                        {
                            int spacing = 0;
                            if (len > 1)
                            {
                                while (len > 1)
                                {
                                    char c = *p++;
                                    len--;
                                    if (c >= '0' && c <= '9')
                                    {
                                        spacing *= 10;
                                        spacing += c - '0';
                                    }
                                    else
                                        break;
                                }
                            }
                            vc->multiline_spacing = spacing;
                        }
                        break;

                    case WimpValidation_Matrix:           /* 'M': Matrix operations */
                        /* FIXME: Not extracted yet */
                        break;

                    case WimpValidation_Name:             /* 'N': Used by various template editors */
                        break;

                    case WimpValidation_Pointer:          /* 'P': Set pointer from sprite name and active posn */
                        vc->pointer_offset = p - vstr; /* FIXME: Should we store the length too ? */
                        break;

                    case WimpValidation_Border:           /* 'R': Border type */
                        {
                            if (len > 1)
                            {
                                int border_type = 0;
                                char c = *p++;
                                len--;
                                if (c >= '0' && c <= '9')
                                {
                                    border_type = c - '0';
                                    while (len > 1)
                                    {
                                        c = *p++;
                                        len--;
                                        if (c >= '0' && c <= '9')
                                        {
                                            border_type *= 10;
                                            border_type += c - '0';
                                        }
                                        else
                                            break;
                                    }
                                    vc->border_type = border_type;
                                    vc->border_slabin = WimpColour_None;

                                    if (c == ',')
                                    {
                                        /* There is a second parameter, which is also a decimal */
                                        int colour = 0;
                                        while (len > 1)
                                        {
                                            c = *p++;
                                            len--;
                                            if (c >= '0' && c <= '9')
                                            {
                                                colour *= 10;
                                                colour += c - '0';
                                            }
                                            else
                                            {
                                                break;
                                            }
                                        }
                                        vc->border_slabin = colour < 16 ? colour : WimpColour_None;
                                    }
                                }
                            }
                        }
                        break;

                    case WimpValidation_Sprite:           /* 'S': Sprite name */
                        vc->sprite_off_offset = p - vstr;
                        while (len-- > 1)
                        {
                            char c = *p++;
                            if (c == ',')
                            {
                                vc->sprite_on_offset = p - vstr;
                                break;
                            }
                            if (c=='\\')
                            {
                                len--; p++;
                            }
                        }
                        break;

                    case WimpValidation_Tint:             /* 'T': Tinting sprites */
                        /* FIXME: Not extracted yet */
                        break;

                    case WimpValidation_CharLimit:        /* 'U': Max number of Unicode characters allowed */
                        break;

                    case WimpValidation_NoAuto:           /* 'X': wimp doesn't auto size iconbar icons */
                        break;

                    case WimpValidation_Flag:             /* 'Y': Flag operation */
                        {
                            uint32_t flags = 0;
                            while (len-- > 1)
                            {
                                char c = *p++;
                                if (c == '\\')
                                {
                                    c = *p++;
                                    len--;
                                }
                                if ((c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z'))
                                    flags |= (1<<((c&31)-1));
                            }
                            vc->flags = flags;
                        }
                        break;

                    case WimpValidation_Border300:        /* 'Z': RISC OS 3.00 border (replaced by 'R') */
                        break;
                }
            }
            start = next;
        }
    }
    return vc;
}
